# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入れない）
# Supabase の URL と anon キーは、ダッシュボードの Project Settings > API にある。
# 未設定の間は、ブラウザ保存のモックデータで動く。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 開発中はログインなし（false）。公開前にログイン機能を追加したら true にする。
# 本番ビルド（next start / Vercel）では true でないとデータ操作を拒否する。
NEXT_PUBLIC_AUTH_ENABLED=false

# ログインなしの間に使う開発用ユーザーID（supabase/dev/dev_open_access.sql の値と同じ）
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
